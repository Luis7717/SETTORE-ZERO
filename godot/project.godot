; Tiro a Giro 3D — progetto Godot 4.7 (versione app del gioco, in costruzione).
; Questo file lo scrive a mano chi lavora al progetto: se lo apri e lo salvi dall'editor, Godot lo riordina
; (va bene) ma controlla nel diff che le impostazioni sotto restino uguali.
;
; Scelte (spiegate in godot/README.md):
; - renderer Mobile (Metal su iPhone), schermo verticale 390×844 punti logici, stretch "canvas_items" + "expand"
;   (l'interfaccia segue i punti dell'iPhone, il 3D si allarga su tutto lo schermo, aree sicure gestite dal codice);
; - compressione texture ETC2/ASTC accesa: senza, l'export iOS si rifiuta di partire.

config_version=5

[application]

config/name="Tiro a Giro 3D"
config/description="Gioco di calcio a un dito, schermo verticale."
config/version="0.1.0"
run/main_scene="res://scenes/prova_campo.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icons/icon_1024.png"
boot_splash/bg_color=Color(0.0627451, 0.105882, 0.0705882, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/ios/allow_high_refresh_rate=false
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true
window/ios/suppress_ui_gesture=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.47, 0.64, 0.86, 1)
